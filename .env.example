# Copy to .env and fill in. SVLA reads these via pydantic-settings (prefix SVLA_).

# --- LLM (root-cause hypothesis agent) ---
# If unset, the hypothesis agent falls back to deterministic rule-based reasoning.
ANTHROPIC_API_KEY=
SVLA_LLM_PROVIDER=anthropic
SVLA_LLM_MODEL=claude-opus-4-8
SVLA_LLM_MAX_TOKENS=1024

# --- Embeddings / clustering ---
SVLA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SVLA_CLUSTER_MIN_SIZE=3

# --- RAG ---
SVLA_VECTOR_BACKEND=chroma        # chroma | memory
SVLA_CHROMA_DIR=.chroma
SVLA_RAG_TOP_K=5

# --- Privacy / classification ---
SVLA_REDACT=1                     # scrub PII & secrets at parse time
SVLA_EVIDENCE_WINDOW_MS=8000

# --- Paths ---
SVLA_LOGS_DIR=data/silicon_logs
SVLA_LABELS_DIR=data/labels
SVLA_REPORTS_DIR=reports

# --- Evaluation ---
SVLA_EVAL_HOLDOUT=0.3

# --- Behaviour ---
SVLA_LOG_LEVEL=INFO
SVLA_OFFLINE=0                    # 1 = force network-free deterministic paths (CI)
